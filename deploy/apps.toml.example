# Primitive Launcher: copy this file to apps.toml (same folder) and edit it.
# Most of this can also be done on the Kindle: long-press an app to move it, change its icon (PNG files in
# /mnt/us/launcher/icons) or hide it; Settings > Hidden apps shows them again. The launcher then rewrites
# this file (comments are not kept). KUAL extensions (/mnt/us/extensions/*/menu.json) appear behind the
# Extensions tile. Sleep pictures: PNG files in /mnt/us/launcher/screensavers, with Settings > Sleep screen
# set to the launcher's own.
# Scriptlets in /mnt/us/documents appear without any entry here. Use entries to add other programs,
# rename, reorder, hide, or set an icon (a PNG; square looks best: icons are rounded squares).

# The grid is 4 columns × 5 rows unless set here (columns 3–5, rows 3–6):
# columns = 4
# rows = 5

# A program that has no scriptlet:
# [[app]]
# id = "kterm"
# name = "Terminal"
# command = "/mnt/us/extensions/kterm/bin/kterm.sh"
# dir = "/mnt/us/extensions/kterm"
# icon = "/mnt/us/launcher/icons/kterm.png"
# order = 3

# A discovered scriptlet (its id is the file name): move it first.
# [[app]]
# id = "Primitive Browser.sh"
# order = 1

# A program that runs while the launcher stays in front; its last output line is shown when it ends:
# [[app]]
# id = "sync"
# name = "Sync notes"
# command = "/mnt/us/scripts/sync.sh"
# mode = "background"

# Hide an app:
# [[app]]
# id = "kindle"
# hidden = true
